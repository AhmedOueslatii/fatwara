# Postgres (local docker)
POSTGRES_PASSWORD=localdevpassword
DATABASE_URL=postgresql+asyncpg://postgres:localdevpassword@db:5432/fatwara

# JWT (generate a strong secret in production: `openssl rand -hex 32`)
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
JWT_LIFETIME_SECONDS=604800

# MinIO (local docker)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_CERTS=certs
MINIO_SECURE=false

# TTN sandbox — leave blank during POC; mock client is used until matricule + creds arrive
TTN_SANDBOX=true
TTN_BASE_URL=
TTN_CLIENT_ID=
TTN_CLIENT_SECRET=

# TEIF schema version — never change without a migration
TEIF_SCHEMA_VERSION=1.8.7
TEIF_STRICT_VALIDATION=false

# Environment
ENVIRONMENT=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
